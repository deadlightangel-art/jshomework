      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const randomEmail =\"test_\" + Date.now() + \"@test.com\";\r",
              "pm.collectionVariables.set(\"email\", randomEmail);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "pm.environment.set(\"userId\", response.data.userId);\r",
              "pm.environment.set(\"token\", response.data.token);\r",
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Status is ok\", function () {\r",
              "    pm.expect(response.status).to.eql(\"ok\");\r",
              "});\r",
              "\r",
              "pm.test(\"User id exists\", function () {\r",
              "    pm.expect(response.data.userId).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Token exists\", function () {\r",
              "    pm.expect(response.data.token).to.exist;\r",
              "});\r",
              "const schema = {\r",
              "    type: \"object\",\r",
              "    required: [\"status\", \"data\"],\r",
              "    properties: {\r",
              "        status: {\r",
              "            type: \"string\"\r",
              "        },\r",
              "        data: {\r",
              "            type: \"object\",\r",
              "            required: [\"userId\"],\r",
              "            properties: {\r",
              "                userId: {\r",
              "                    type: \"number\"\r",
              "                }\r",
              "            }\r",
              "        }\r",
              "    }\r",
