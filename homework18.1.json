    {
      "name": "Homework 16.1",
      "item": [
        {
          "name": "Get all cities",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const cities = pm.response.json().data.getAllCities;\r",
                  "\r",
                  "// Save all cities\r",
                  "pm.collectionVariables.set(\r",
                  "\"cities\",\r",
                  "JSON.stringify(cities)\r",
                  ");\r",
                  "\r",
                  "// Select 4 random cities\r",
                  "const randomCities = [...cities]\r",
                  ".sort(() => 0.5 - Math.random())\r",
                  ".slice(0, 4);\r",
                  "\r",
                  "// Save IDs\r",
                  "pm.collectionVariables.set(\r",
                  "\"randomIds\",\r",
                  "JSON.stringify(\r",
                  "randomCities.map(city => city.id)\r",
                  ")\r",
                  ");\r",
                  "\r",
                  "// Average square of ALL cities\r",
                  "const avgSquare =\r",
                  "cities.reduce(\r",
                  "(sum, city) => sum + city.square,\r",
                  "0\r",
                  ") / cities.length;\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "\"avgSquare\",\r",
                  "avgSquare\r",
                  ");\r",
                  "\r",
                  "// Find min and max IDs\r",
                  "const randomIds = JSON.parse(\r",
                  "pm.collectionVariables.get(\"randomIds\")\r",
                  ");\r",
                  "\r",
                  "const ids = randomIds.map(Number);\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "\"minId\",\r",
                  "Math.min(...ids)\r",
                  ");\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "\"maxId\",\r",
                  "Math.max(...ids)\r",
                  ");\r",
                  "\r",
                  "console.log(\"Random IDs:\", randomIds);\r",
                  "console.log(\"Average square:\", avgSquare);\r",
                  "console.log(\"Min ID:\", Math.min(...ids));\r",
                  "console.log(\"Max ID:\", Math.max(...ids));\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n\"query\": \"query { getAllCities { id name square } }\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://graphql-ukrainian-cities.hillel.it/graphql",
              "protocol": "https",
              "host": [
                "graphql-ukrainian-cities",
                "hillel",
                "it"
              ],
              "path": [
                "graphql"
              ]
            }
          },
          "response": []
        },
        {
