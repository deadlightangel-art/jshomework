          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ids = JSON.parse(pm.collectionVariables.get(\"randomIds\"));\r",
                  "const index = Number(pm.collectionVariables.get(\"descriptionIndex\") || 0);\r",
                  "\r",
                  "pm.collectionVariables.set(\"cityId\", ids[index]);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Description exists\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response.data.getCityDescription).to.exist;\r",
                  "    pm.expect(response.data.getCityDescription).to.be.a(\"string\");\r",
                  "});\r",
                  "\r",
                  "const ids = JSON.parse(\r",
                  "    pm.collectionVariables.get(\"randomIds\")\r",
                  ");\r",
                  "\r",
                  "let currentIndex = parseInt(\r",
                  "    pm.collectionVariables.get(\"descriptionIndex\") || \"0\"\r",
                  ");\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "    \"currentId\",\r",
                  "    ids[currentIndex]\r",
                  ");\r",
                  "\r",
                  "console.log(\r",
                  "    \"Description for ID:\",\r",
                  "    ids[currentIndex]\r",
                  ");\r",
                  "\r",
                  "currentIndex++;\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "    \"descriptionIndex\",\r",
                  "    currentIndex\r",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
